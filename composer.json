{
    "name": "vemcogroup/laravel-translation",
    "description": "Translation package for Laravel to scan for localisations and up/download to poeditor",
    "keywords": [
        "i18n",
        "laravel",
        "poeditor",
        "translations"
    ],
    "homepage": "https://github.com/vemcogroup/laravel-translation",
    "license": "MIT",
    "authors": [
        {
            "name": "VG devs",
            "email": "support@vemcount.com",
            "homepage": "https://vemcogroup.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "symfony/finder": "^6.0|^7.0",
        "guzzlehttp/guzzle": "^7.0",
        "laravel/framework": "^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Vemcogroup\\Translation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Vemcogroup\\Translation\\TranslationServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
